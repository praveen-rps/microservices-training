<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="
        http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

	<!-- bean definitions here -->
	<bean id="book1" class="springdemo.model.Book" scope="prototype">
		<property name="isbn" value="34567" />
		<property name="author" value="JK Rowling" />
		<property name="name" value="Harry Potter" />

	</bean>


	<bean id="emp" class="springdemo.model.Employee" init-method="initMethod" destroy-method="destroyMethod">
		<property name="empid" value="1234" />
		<property name="name" value="JK Rowling" />
		<property name="dept" value="Production" />

	</bean>

	<bean id="address" class="springdemo.model.Address">
		<constructor-arg value="12" />
		<constructor-arg value="OMR Road" />
		<constructor-arg value="Chennai" />
	</bean>

	<bean id="address1" class="springdemo.model.Address">
		<constructor-arg value="123" />
		<constructor-arg value="HMT Road" />
		<constructor-arg value="Chennai" />
	</bean>
	
	
	<bean id="person" class="springdemo.model.Person" autowire="byName">
		<property name="id" value="1234" />
		<property name="name" value="Krishna" />
		
	</bean>

</beans>